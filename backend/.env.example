# 服务器配置
PORT=3001
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=battery_investment
DB_USER=postgres
DB_PASSWORD=your_password

# JWT配置
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production
JWT_EXPIRES_IN=7d

# 分红配置
PROFIT_SHARE_RATIO=0.70  # 70%利润分红给投资者

# 柬埔寨市场配置
EXCHANGE_RATE_USD_KHR=4100  # 美元兑瑞尔汇率
BATTERY_UNIT_PRICE=1000     # 每单位电池资产价格(USD)
